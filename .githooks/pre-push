#!/bin/sh
# Block pushes that introduce new secrets (gh#233).
#
# GitHub's push protection only stops a secret's FIRST introduction — the
# gh#232 key sailed through a second time in 687fee1 because an alert was
# already open on it. This hook has no such carve-out: anything not already
# fingerprinted in .gitleaksignore blocks the push.
#
# Install: git config core.hooksPath .githooks
# Bypass (deliberate, rare): git push --no-verify

set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not installed — secret scan SKIPPED."
  echo "          brew install gitleaks   (see gh#233)"
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
ZERO=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
STATUS=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion — nothing to scan.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch: scan only what it adds beyond existing remote heads, so a
    # first push doesn't re-scan all of history.
    RANGE="$local_sha --not $(git for-each-ref --format='%(refname)' refs/remotes/ | tr '\n' ' ')"
    [ "$RANGE" = "$local_sha --not " ] && RANGE="$local_sha"
  else
    RANGE="$remote_sha..$local_sha"
  fi

  if ! gitleaks git "$ROOT" \
        --log-opts="$RANGE" \
        --config "$ROOT/.gitleaks.toml" \
        --gitleaks-ignore-path "$ROOT" \
        --redact \
        --no-banner \
        --log-level error; then
    STATUS=1
  fi
done

if [ "$STATUS" -ne 0 ]; then
  cat <<'MSG'

  ✖ Push blocked: a new secret was found in the commits above.

  Secrets are redacted here on purpose — read the finding's file:line.

  If it is a real secret:
    1. Remove it from the code; load it from the environment instead.
    2. Rotate it. It is already on this machine's disk and in a local
       commit, so treat it as exposed.
    3. Amend or rebase so the value never reaches the remote.

  If it is a false positive, add an allowlist entry to .gitleaks.toml
  (preferred — it stays true as the code moves) or append the reported
  fingerprint to .gitleaksignore with a comment saying why.

MSG
  exit 1
fi

exit 0
